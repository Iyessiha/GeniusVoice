# ─── Base de données (Supabase / Postgres) ─────────────────────────────
DATABASE_URL=
# DATABASE_SSL_CA=   # certificat racine Supabase ("\n" pour les retours à la ligne)

# ─── IA vocale (OpenAI Realtime) ──────────────────────────────────────
# Ne JAMAIS exposer cette clé au navigateur : le serveur émet des jetons
# éphémères via /api/realtime/session.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# ─── Paiement mobile money (GeniusPay) ────────────────────────────────
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# GENIUSPAY_INIT_URL=https://geniuspay.ci/api/v1/merchant/payments

# ─── E-mails (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
# RESEND_FROM="GeniusVoice <no-reply@genius.ci>"

# ─── Application ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=
